# Copie este arquivo para ".env" e ajuste com os dados do seu PostgreSQL.

# String de conexão do PostgreSQL.
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
ConnectionStrings__Default=Host=localhost;Port=5432;Database=clinica;Username=postgres;Password=postgres

# Porta em que o servidor local vai rodar
PORT=5000

# Chave secreta para assinar o login (gerada automaticamente na primeira execução
# se você deixar em branco — mas é melhor definir uma fixa para não derrubar
# os logins toda vez que reiniciar o sistema)
JWT_SECRET=troque-esta-chave-por-um-texto-aleatorio-bem-grande
